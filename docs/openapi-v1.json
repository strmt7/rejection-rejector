    "/v1/item-feed": {
      "get": {
        "summary": "Snapshot-consistent retained-item feed",
        "description": "Cursor-based traversal over a fixed SQLite row high-water mark. New messages arriving after the first page do not shift or appear inside the in-progress traversal. Cursor values are opaque URL-safe tokens.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation cursor returned by the previous page.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot-consistent item page",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-RR-API-Contract-SHA256": {
                "$ref": "#/components/headers/ContractFingerprint"
              },
              "X-RR-Build-Identity-SHA256": {
                "$ref": "#/components/headers/BuildIdentityFingerprint"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "integer",
                      "const": 1
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
