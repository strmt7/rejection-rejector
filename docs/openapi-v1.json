{
  "openapi": "3.1.0",
  "info": {
    "title": "Rejection Rejector Local Integration API",
    "version": "1.5.0",
    "description": "Authenticated, read-only, loopback-only integration API. Browser Origin requests are refused, responses are no-store, every response carries X-Request-ID, and errors use stable machine-readable codes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8734"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random local token stored encrypted by Rejection Rejector."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "error"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "worker_busy"
                ]
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "AutomaticPolicyBlock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable snake_case automatic-policy reason code."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AutomaticPolicyDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eligible",
          "blocks"
        ],
        "properties": {
          "eligible": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AutomaticPolicyBlock"
            }
          }
        }
      },
      "RuntimeLogStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "available",
          "current_bytes",
          "archive_bytes",
          "total_bytes",
          "archive_count",
          "max_current_bytes",
          "max_archives"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "available": {
            "type": "boolean"
          },
          "current_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "archive_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "total_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "archive_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_current_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "max_archives": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "Privacy-minimal local runtime-journal storage health; contains no log records or private mailbox/profile fields."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Per-request correlation identifier generated locally by Rejection Rejector.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or unavailable resource",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication, Host or Origin policy rejected the request",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The endpoint is read-only",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "WorkerUnavailable": {
        "description": "Worker queue busy or local worker timeout",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/live": {
      "get": {
        "summary": "Process/API-thread liveness",
        "responses": {
          "200": {
            "description": "API thread is alive",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This API contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Versioned capability discovery",
        "responses": {
          "200": {
            "description": "Capabilities",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Workspace readiness and integrity",
        "responses": {
          "200": {
            "description": "Readiness state including database integrity, enterprise policy, typed worker operation state and privacy-minimal runtime-journal storage health.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "description": "Worker unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Application status",
        "responses": {
          "200": {
            "description": "Status",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/items": {
      "get": {
        "summary": "Paginated retained jobs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job page",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/items/{id}": {
      "get": {
        "summary": "One retained job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Audit events after sequence",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit events",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/audit/anchor": {
      "get": {
        "summary": "Current tamper-evident audit-chain anchor",
        "responses": {
          "200": {
            "description": "Audit anchor",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/audit/contains": {
      "get": {
        "summary": "Check whether an audit anchor is known",
        "parameters": [
          {
            "name": "head",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Anchor membership",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "summary": "Privacy-safe operational metrics snapshot",
        "description": "Aggregate local operational metrics only. No mailbox address, message content, recipients, OAuth credentials, API token, signature, or candidate facts are included.",
        "responses": {
          "200": {
            "description": "Metrics snapshot",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "schema_version",
                    "generated_at",
                    "service_name",
                    "application_version",
                    "database_schema_version",
                    "stored_items",
                    "queued_items",
                    "review_items",
                    "sent_items",
                    "uncertain_deliveries",
                    "send_attempts_24h",
                    "operational"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/item-feed": {
      "get": {
        "summary": "Snapshot-consistent retained-item feed",
        "description": "Cursor-based traversal over a fixed SQLite row high-water mark. New messages arriving after the first page do not shift or appear inside the in-progress traversal. Cursor values are opaque URL-safe tokens.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation cursor returned by the previous page.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot-consistent item page",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "integer",
                      "const": 1
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    },
    "/v1/items/{id}/automatic-policy": {
      "get": {
        "summary": "Explain whether a stored rejection is eligible for unattended dispatch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Automatic-dispatch policy decision",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomaticPolicyDecision"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/WorkerUnavailable"
          }
        }
      }
    }
  }
}
