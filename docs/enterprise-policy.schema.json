{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/strmt7/rejection-rejector/blob/main/docs/enterprise-policy.schema.json",
  "title": "Rejection Rejector Enterprise Policy",
  "description": "Deployment-time schema for enterprise policy versions 1-3. Runtime semantic validation remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "policy_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "not_before": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "force_human_review": {
      "type": "boolean",
      "default": false
    },
    "prohibit_sending": {
      "type": "boolean",
      "default": false
    },
    "prohibit_integration_api": {
      "type": "boolean",
      "default": false
    },
    "prohibit_recovery_key_export": {
      "type": "boolean",
      "default": false
    },
    "require_external_audit_anchor": {
      "type": "boolean",
      "default": false
    },
    "require_independent_verifier": {
      "type": "boolean",
      "default": false
    },
    "max_daily_send_limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "min_cooldown_minutes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1440
    },
    "min_retention_days": {
      "type": ["integer", "null"],
      "minimum": 30,
      "maximum": 3650
    },
    "allowed_models": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "default": []
    },
    "allowed_verifier_models": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": { "const": 1 }
        },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "policy_id": { "type": "null" },
          "revision": { "type": "null" },
          "not_before": { "type": "null" },
          "expires_at": { "type": "null" },
          "require_independent_verifier": { "const": false },
          "allowed_verifier_models": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": { "enum": [2, 3] }
        },
        "required": ["version"]
      },
      "then": {
        "required": ["policy_id", "revision"]
      }
    },
    {
      "if": {
        "properties": {
          "version": { "enum": [1, 2] }
        },
        "required": ["version"]
      },
      "then": {
        "properties": {
          "require_independent_verifier": { "const": false },
          "allowed_verifier_models": { "maxItems": 0 }
        }
      }
    }
  ]
}
