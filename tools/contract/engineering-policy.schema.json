{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portfolio-engineering-manual:2026-10-27:engineering-policy.schema.json",
  "title": "engineering-policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
