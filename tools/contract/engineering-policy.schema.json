      "additionalProperties": false
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "lifecycle": {
      "enum": [
        "maintained",
        "maintenance-only",
        "experiment",
        "superseded"
      ]
